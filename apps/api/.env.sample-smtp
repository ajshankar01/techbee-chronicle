# ==============================================================================
# SMTP EMAIL CONFIGURATION FOR TESTING
# ==============================================================================
# To test emails locally without accidentally emailing real candidates, 
# it is highly recommended to use a dummy SMTP catcher like Mailtrap (mailtrap.io) 
# or Ethereal Email (ethereal.email).
#
# Once ready for production at HCL, you can replace these with the Office365 details.
# ==============================================================================

# Enable the email sending engine (Set to False to fall back to dev console logs)
SMTP_ENABLED=True

# ------------------------------------------------------------------------------
# OPTION 1: MAILTRAP (Recommended for safe local testing)
# Go to mailtrap.io -> Create an Inbox -> Copy SMTP details
# ------------------------------------------------------------------------------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
SMTP_FROM="TechBee Chronicle HR <techbeechronical@hcltech.com>"

# ------------------------------------------------------------------------------
# OPTION 2: GMAIL APP PASSWORDS (If you want to send real emails to yourself)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_personal_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
# SMTP_FROM="TechBee Chronicle HR <your_personal_email@gmail.com>"

# ------------------------------------------------------------------------------
# OPTION 3: HCL OFFICE365 (Final Production Setup)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=techbeechronical@hcltech.com
# SMTP_PASS=hcl_provided_app_password
# SMTP_FROM="TechBee Chronicle HR <techbeechronical@hcltech.com>"
