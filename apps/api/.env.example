# =============================================================================
# AI Interview Platform - API Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="TechBee AI Interview Platform"
APP_VERSION=1.0.0
SECRET_KEY=your-super-secret-key-change-in-production
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/techbee_interviews
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/techbee_interviews

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Microsoft Azure AD / Teams SSO ──────────────────────────────────────────
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id

# Restrict HR auto-provisioning to this email domain.
# Set to "" to disable (not recommended for production).
ALLOWED_HR_DOMAIN=hcltech.com

# ─── Google Cloud ─────────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GCS_BUCKET_NAME=techbee-interview-recordings
GCS_BUCKET_REPORTS=techbee-interview-reports
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ─── OpenAI Whisper (STT) ─────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ─── Simli.ai (AI Avatar) ─────────────────────────────────────────────────────
SIMLI_API_KEY=your-simli-api-key
SIMLI_FACE_ID=aria-professional-v1

# ─── Google Cloud TTS (Aria's Voice) ─────────────────────────────────────────
GOOGLE_TTS_VOICE_NAME=en-IN-Neural2-A
GOOGLE_TTS_LANGUAGE_CODE=en-IN

# ─── Email / SMTP (Interview Invitations) ────────────────────────────────────
# Used to send interview invitations and calendar (.ics) blocks from
# techbeechronical@hcltech.com to candidates.
#
# Steps to enable:
#   1. Get management approval and create techbeechronical@hcltech.com
#   2. Enable SMTP AUTH in Microsoft 365 Admin for that mailbox
#   3. Generate an App Password (NOT the account password)
#   4. Fill in the values below and set SMTP_ENABLED=True
#
# Office 365 SMTP details (HCL / Outlook):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=techbeechronical@hcltech.com
SMTP_PASS=your-app-password-here
SMTP_FROM=TechBee Chronicle HR <techbeechronical@hcltech.com>
SMTP_ENABLED=False

# ─── App URL (used in invitation email links) ─────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
